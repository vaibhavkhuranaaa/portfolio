name: Request automatic portfolio publication

on:
  push:
    branches: [main]
    paths: [portfolio/project.json]

permissions: {}

jobs:
  dispatch:
    runs-on: ubuntu-latest
    steps:
      - name: Dispatch only a verified live project
        env:
          GH_TOKEN: ${{ secrets.PORTFOLIO_DISPATCH_TOKEN }}
          PORTFOLIO_REPOSITORY: ${{ vars.PORTFOLIO_REPOSITORY }}
        run: |
          node -e 'const p=require("./portfolio/project.json"); if (p.deployment?.status !== "live" || !p.liveUrl || !p.deployment?.verifiedAt) process.exit(78)'
          gh api --method POST "repos/${PORTFOLIO_REPOSITORY}/dispatches" -f event_type=project-release-ready -f client_payload[repository]="$GITHUB_REPOSITORY" -f client_payload[ref]="$GITHUB_SHA" -f client_payload[manifest_path]="portfolio/project.json"
