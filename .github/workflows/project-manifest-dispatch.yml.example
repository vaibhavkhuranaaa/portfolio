name: Request a portfolio manifest preview

on:
  push:
    branches: [main]
    paths: [portfolio/project.json]

permissions: {}

jobs:
  dispatch:
    runs-on: ubuntu-latest
    steps:
      - name: Dispatch portfolio preview
        env:
          GH_TOKEN: ${{ secrets.PORTFOLIO_DISPATCH_TOKEN }}
          PORTFOLIO_REPOSITORY: ${{ vars.PORTFOLIO_REPOSITORY }}
        run: gh api --method POST "repos/${PORTFOLIO_REPOSITORY}/dispatches" -f event_type=project-manifest-ready -f client_payload[repository]="$GITHUB_REPOSITORY" -f client_payload[ref]="$GITHUB_SHA" -f client_payload[manifest_path]="portfolio/project.json"
